# Copy to .env and adjust. .env is never committed.

# PostgreSQL
POSTGRES_DB=drawandplay
POSTGRES_USER=drawandplay
POSTGRES_PASSWORD=change-me
# Host port of the database (bound to 127.0.0.1 only), e.g. for `npm run dev`
DB_PORT=5432

# First admin account, created on startup if it does not exist (password at least 12 characters).
# An existing account is never changed, so these may stay set.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Legal notice (Impressum) and privacy policy, linked in the footer of the public pages, e.g. the club website.
# Defaults for all events; each event can set its own links under Setup.
IMPRINT_URL=https://example.org/impressum
PRIVACY_URL=https://example.org/datenschutz

# Backups (service "backup"): a pg_dump every BACKUP_INTERVAL_MINUTES into BACKUP_DIR on the host.
# On the tournament day a shorter interval such as 15 is sensible. Older dumps than BACKUP_KEEP_DAYS are deleted.
BACKUP_INTERVAL_MINUTES=60
BACKUP_KEEP_DAYS=14
BACKUP_DIR=./backups

# Reverse proxy (Caddy)
# Local: ":80" serves any host name over plain HTTP.
# Server: set your domain (e.g. tournament.example.org) and Caddy fetches a certificate automatically.
#         Then also set HTTP_PORT=80 and HTTPS_PORT=443.
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443

# Docker image of the app. Empty: built from this folder (`docker compose up -d --build`).
# On a server, use a released image matching the checked-out version, e.g. ghcr.io/samu1921/draw-and-play:0.1.0 (docs/deploy.md).
APP_IMAGE=

# For `npm run dev` outside Docker (read directly by the server)
DATABASE_URL=postgres://drawandplay:change-me@localhost:5432/drawandplay
